# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
aws_region    = "ap-south-1"
instance_type = "t3.small"

# Find your IP: curl https://checkip.amazonaws.com
admin_cidr = "203.0.113.7/32"

# CloudWatch alarm emails (confirm the subscription email AWS sends you)
alert_email = "you@example.com"
